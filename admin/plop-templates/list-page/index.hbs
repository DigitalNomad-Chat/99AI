<route lang="yaml">
meta:
  title: {{ title }}
</route>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import type { FormInstance } from 'element-plus'

defineOptions({
  name: '{{ properCase componentName }}',
})

const formRef = ref<FormInstance>()
const loading = ref(false)
const total = ref(0)

// 查询表单
const formInline = reactive({
  page: 1,
  size: 10,
  {{#each queryFields}}
  {{@key}}: '',
  {{/each}}
})

// 表格数据
const tableData = ref([])

// 分页查询
async function queryList() {
  try {
    loading.value = true
    // TODO: 替换为实际的API调用
    // const res = await Api{{properCase componentName}}.queryList(formInline)
    // tableData.value = res.data.rows
    // total.value = res.data.count
  } catch (error) {
    console.error('查询失败:', error)
  } finally {
    loading.value = false
  }
}

// 重置查询
function handlerReset(formEl: FormInstance | undefined) {
  formEl?.resetFields()
  queryList()
}

// 页面挂载时查询
onMounted(() => {
  queryList()
})
</script>

<template>
  <PageHeader>
    <template #title>
      <div class="flex items-center gap-4">{{ title }}</div>
    </template>
  </PageHeader>

  <page-main>
    <!-- 查询表单 -->
    <el-form ref="formRef" :inline="true" :model="formInline" class="mb-4">
      {{#each queryFields}}
      <el-form-item label="{{label}}" prop="{{@key}}">
        <el-input
          v-model="formInline.{{@key}}"
          placeholder="{{placeholder}}"
          clearable
        />
      </el-form-item>
      {{/each}}
      <el-form-item>
        <el-button type="primary" @click="queryList"> 查询 </el-button>
        <el-button @click="handlerReset(formRef)"> 重置 </el-button>
      </el-form-item>
    </el-form>

    <!-- 数据表格 -->
    <el-table
      v-loading="loading"
      border
      :data="tableData"
      style="width: 100%"
      size="default"
      class="mt-4"
    >
      {{#each tableColumns}}
      <el-table-column prop="{{prop}}" label="{{label}}" {{#if width}}width="{{width}}"{{/if}} {{#if align}}align="{{align}}"{{/if}} />
      {{/each}}

      <!-- 操作列 -->
      <el-table-column label="操作" width="200" align="center" fixed="right">
        <template #default="scope">
          <el-button
            class="action-btn action-btn-primary"
            @click="handleEdit(scope.row)"
          >
            编辑
          </el-button>
          <el-popconfirm
            title="确认删除此记录吗?"
            width="180"
            icon-color="red"
            @confirm="handleDelete(scope.row)"
          >
            <template #reference>
              <el-button class="action-btn action-btn-danger">
                删除
              </el-button>
            </template>
          </el-popconfirm>
        </template>
      </el-table-column>
    </el-table>

    <!-- 分页 -->
    <el-row class="mt-5 flex justify-end">
      <el-pagination
        v-model:current-page="formInline.page"
        v-model:page-size="formInline.size"
        class="mr-5"
        :page-sizes="[10, 20, 30, 50]"
        layout="total, sizes, prev, pager, next, jumper"
        :total="total"
        @size-change="queryList"
        @current-change="queryList"
      />
    </el-row>
  </page-main>
</template>

<style scoped>
/* 操作按钮样式 - 提升可读性和点击体验 */
.action-btn {
  padding: 8px 16px;
  font-size: 14px;
  border: 1px solid transparent;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s ease;
  background: transparent;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.action-btn-primary {
  color: #409eff;
  border-color: #d9ecff;
}

.action-btn-primary:hover {
  background: #ecf5ff;
  border-color: #409eff;
  color: #409eff;
}

.action-btn-primary:active {
  background: #d9ecff;
}

.action-btn-danger {
  color: #f56c6c;
  border-color: #fde2e2;
}

.action-btn-danger:hover {
  background: #fef0f0;
  border-color: #f56c6c;
  color: #f56c6c;
}

.action-btn-danger:active {
  background: #fde2e2;
}

/* 确保按钮在表格中居中对齐 */
.el-table .el-table__cell {
  padding: 12px 0;
}
</style>
